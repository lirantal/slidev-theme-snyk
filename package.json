{
  "name": "slidev-theme-snyk",
  "version": "0.0.0",
  "type": "module",
  "keywords": [
    "slidev-theme",
    "slidev"
  ],
  "engines": {
    "npm": ">=11.10.0",
    "node": ">=24.0.0"
  },
  "scripts": {
    "slides:agent-scan": "slidev talk-agent-scan-and-malicious-skills --theme ./ --remote --bind 0.0.0.0",
    "preview:agent-scan": "slidev build talk-agent-scan-and-malicious-skills.md --theme ./ && vite preview --outDir dist --host 0.0.0.0 --port 3031 --strictPort",
    "build": "slidev build example.md",
    "dev": "slidev example.md --remote --bind 0.0.0.0 --open",
    "export": "slidev export example.md",
    "screenshot": "slidev export example.md --format png"
  },
  "dependencies": {
    "@slidev/types": "^52.14.2"
  },
  "devDependencies": {
    "@slidev/cli": "^52.14.2"
  },
  "optionalDependencies": {
    "@oxc-parser/binding-linux-arm64-gnu": "0.124.0"
  },
  "//": "Learn more: https://sli.dev/guide/write-theme.html",
  "slidev": {
    "colorSchema": "both",
    "defaults": {
      "fonts": {
        "sans": "Nunito Sans",
        "serif": "Sora",
        "mono": "JetBrains Mono"
      },
      "transition": "snyk-fade"
    }
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  }
}
